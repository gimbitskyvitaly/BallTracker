# Пример конфигурации pass-tracker. Скопируйте в .env и заполните ключи.
# Файл .env перечитывается при старте сервиса (pass_tracker/main.py -> _load_dotenv).

# --- Ключи LLM -------------------------------------------------------------
OPENAI_API_KEY=sk-your-key-here
ANTHROPIC_API_KEY=your-key-here
LLM_MODEL=gpt-4o-mini

# --- Источник видео --------------------------------------------------------
# VIDEO_SOURCE=/path/to/video.mp4   # пустой/не задан -> камера 0
VIDEO_FPS=25.0
OUTPUT_DIR=output

# --- Детекция игроков (YOLO + ByteTrack) -----------------------------------
# По умолчанию выключена: без неё фильтр паса работает только по геометрии.
PLAYER_DETECTION_ENABLED=false
# PLAYER_MODEL_PATH=models/yolo_football.pt
# PLAYER_CLASSES=player
# CONF_THRESHOLD=0.4

# --- Фильтр паса (PassAnalyzer) ---------------------------------------------
# Кандидат = подача/приём/атака/пас; пасом становится только выраженная
# горизонтальная парабола от игрока. Пороги подстраиваются под конкретное видео.
PASS_MIN_HORIZONTAL_PX=40          # минимальный горизонтальный пролёт мяча
PASS_MIN_AIRTIME_S=0.25            # минимальное время полёта между ключpointами
PASS_MAX_AIRTIME_S=5.0             # максимум времени полёта
PASS_MIN_ARC_HEIGHT_PX=12          # минимальная высота дуги над хордой полёта
PASS_MIN_PEAK_SPEED_PX_S=30        # минимальный пик горизонтальной скорости
PASS_REQUIRE_DIRECTION_CHANGE=true # требовать разворот мяча по горизонтали
PASS_CONTACT_BOX_RATIO=1.5         # макс. дистанция контакта от бокса игрока (доли диагонали)
PASS_OWNER_MAX_AGE_EVENTS=3        # свежесть владения (в событиях)

# --- Буфер кадров вокруг события --------------------------------------------
PRE_FRAMES=12
POST_FRAMES=18
SAMPLE_STRIDE=2
