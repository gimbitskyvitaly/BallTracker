# ============================================================
# Volleyball pass-trajectory service - configuration (ball-time-ai style)
# Все настройки сервиса вынесены в этот файл; переменные окружения
# имеют приоритет над значениями из .env.
# ============================================================

# ---- Input / output ------------------------------------------------
VIDEO_PATH=examples/match.mp4
OUTPUT_DIR=data/output
MODEL_PATH=models/VballNetFastV1_seq9_grayscale_233_h288_w512.onnx

# ---- Inference (модель VballNet из fast-volleyball-tracking-inference) ----
CONFIDENCE_THRESHOLD=0.5
TRACK_LENGTH=30
INFERENCE_DEVICE=CPU            # CPU | CUDA

# ---- Tracking / построение траекторий ------------------------------
FPS=0                           # 0 = брать fps из контейнера видео
MAX_DISTANCE_PX=200             # радиус матчинга при ширине 1920 (масштабируется)
MAX_DISAPPEARED_FRAMES=40       # сколько кадров мяч может быть невидим
MIN_TRACK_POINTS=5
MERGE_GAP_FRAMES=40

# ---- Отрисовка -------------------------------------------------------
# Флаг: true - рисовать ВСЕ траектории мяча, false - только траектории пасов
DRAW_ALL_TRAJECTORIES=false
WRITE_OUTPUT_VIDEO=true
TRAJECTORY_TAIL_FRAMES=45
SHOW_PER_FRAME_INFO=true

# ---- Геометрия сетки (нормализованные координаты кадра x/W, y/H) ----
# Вид с задней линии: верхняя тросо-лента сетки горизонтальна между антеннами.
NET_GEOMETRY_ENABLED=true
NET_TOP_Y_NORM=0.36
NET_LEFT_X_NORM=0.21
NET_RIGHT_X_NORM=0.79
NET_CLEARANCE_NORM=0.01         # запас над лентой, засчитываемый "выше сетки"

# ---- Выбросы (правило: ||p_i-p_{i-1}||>eps && ||p_i-p_{i+1}||>eps && ||p_{i-1}-p_{i+1}||<eps) --
OUTLIER_EPS_RATIO=0.05          # eps как доля ширины кадра
OUTLIER_MAX_ITERATIONS=5

# ---- Критерии паса (гипербола + выше сетки + на край сетки) ---------
PASS_MIN_POINTS=6
PASS_MIN_DURATION_SEC=0.2
PASS_APEX_BEFORE_NET_MIN_SEC=0.1
PASS_HYPERBOLA_MAX_RMSE_RATIO=0.05   # макс. ошибка аппроксимации гиперболой (доля высоты)
PASS_REQUIRE_OVER_NET=true
PASS_NEAR_ANTENNA_MARGIN_RATIO=0.12  # "у края сетки" = конец рядом с антенной (доля ширины)
PASS_MAX_CENTER_OFFSET_RATIO=0.35    # конец не дальше этого смещения от центра (доля ширины)
PASS_MAX_DESCENT_AFTER_APEX_RATIO=0.8 # резкое пике после вершины = атака/подача (доля высоты)
