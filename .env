# Конфигурация сервиса трекинга паса (коммитится намеренно — общие настройки).
BT_BALL_CONF=0.25
# Автопорог «правила соседей» для отбрасывания ложных точек трека (0 = max(30, 5% ширины))
BT_OUTLIER_TOL_PX=0
# Щадящая непрерывность траектории: допуск = mult*медиана шагов (не ниже физ. потолка)
BT_PASS_STEP_MED_MULT=6.0
BT_PASS_MAX_GAP_FRAC=0.25
